# ---------------------------------------------------------------
# Sistema de Gestión de Parqueadero · variables de entorno
# Copia este archivo como .env (desarrollo) y como .env.test (pruebas).
# Nunca subas .env ni .env.test al repositorio.
# ---------------------------------------------------------------

# Puerto HTTP del servidor Express (sirve la API /api/v1 y el frontend)
PORT=3000

# Entorno: development | test | production
NODE_ENV=development

# Zona horaria del proceso (no cambiar: el negocio opera en Medellín, UTC-05:00)
TZ=America/Bogota

# Conexión a MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Base de datos (solo letras, dígitos y _). En .env.test usa parqueaderodb_test.
DB_NAME=parqueaderodb

# Firma de los JWT: cadena aleatoria de 32 caracteres o más.
# Genérala con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Vigencia del token (RNF-SEG-03: 8 horas)
JWT_EXPIRES_IN=8h

# Costo de bcrypt para las contraseñas (RNF-SEG-02: 10 o más)
BCRYPT_COSTO=10

# Origen permitido por CORS. Déjalo vacío si el frontend lo sirve el mismo Express (recomendado).
# Ejemplo en desarrollo con Live Server: http://127.0.0.1:5500
CORS_ORIGIN=

# Proxies inversos delante de Express (0 = acceso directo, 1 = un proxy HTTPS como Nginx o IIS)
TRUST_PROXY=0

# Máximo de peticiones de login por IP cada 15 minutos (constitución §III)
LOGIN_LIMITE_IP=20
