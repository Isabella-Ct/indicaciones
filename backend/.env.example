# ---------------------------------------------------------------
# PARKO · variables de entorno. Copia este archivo como .env
# ---------------------------------------------------------------

# Puerto HTTP del servidor Express (sirve la API y el frontend)
PORT=3000

# Entorno: development | test | production
NODE_ENV=development

# Zona horaria del proceso Node (no cambiar: el negocio opera en Medellín)
TZ=America/Bogota

# Conexión a MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=parking_lot_abc

# Firma de los JWT: cadena larga y aleatoria (mínimo 32 caracteres).
# Genérala con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Vigencia del token y de la cookie de sesión
JWT_EXPIRES_IN=8h

# Proxies inversos delante de Express (0 = acceso directo). Con un proxy HTTPS (Nginx, IIS,
# Caddy) usa 1 para que el límite de intentos de login vea la IP real del cliente.
TRUST_PROXY=0
