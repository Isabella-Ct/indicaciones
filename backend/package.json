{
  "name": "parko-backend",
  "version": "0.1.0",
  "private": true,
  "description": "PARKO · Sistema de gestión del Parqueadero ABC (backend + estáticos)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "lint": "cd .. && eslint --config backend/eslint.config.js backend frontend/js",
    "format": "cd .. && prettier --write backend frontend",
    "db:reset": "node database/reset.js",
    "db:seed:generar": "node database/generar-seed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      ".env"
    ],
    "ext": "js,json"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 15000
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "pdfkit": "^0.20.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  }
}
